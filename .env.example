DATABASE_URL=postgresql+psycopg://starscream:starscream@localhost:5432/starscream
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=starscream
S3_SECRET_KEY=starscream
S3_BUCKET=starscream-audio
S3_REGION=us-east-1

# Optional JSON array of secondary S3 mirrors (R2, B2, Wasabi, ...)
# MIRROR_ENDPOINTS=[{"name":"r2","endpoint":"https://...","access_key":"...","secret_key":"...","bucket":"starscream-audio"}]

API_RATE_LIMIT_PER_MIN=1000
REDIS_URL=
API_TRUST_PROXY_HEADERS=false
PEER_REVIEW_MAX_FLAGS_PER_RECORDING_PER_DAY=15
PEER_REVIEW_MAX_FLAGS_PER_REVIEWER_PER_DAY=10
CORS_ORIGINS=*
ADMIN_API_KEY=

# Catalog-only mode: harvest/export metadata pointers only (no local audio). Set false to enable mirrors.
CATALOG_ONLY=true

FREESOUND_API_KEY=
# Xeno-canto API v3 — https://xeno-canto.org/account (do not commit real keys)
XENO_CANTO_API_KEY=

# Enrichment pipeline (reverse geocode, habitat, weather)
ENRICH_GEOCODE=true
ENRICH_HABITAT=true
ENRICH_WEATHER=true
NOMINATIM_USER_AGENT=Starscream/0.1 (sound catalog; https://github.com/dumbspacecookie/starscream)
NOMINATIM_RATE_LIMIT_S=1.0
